# KisanSetu — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.

# Backend API base URL (no trailing slash)
VITE_API_URL=http://localhost:5000/api

# Set to "true" to use local mock data (no backend needed)
# Set to "false" to connect to the real Node.js + MongoDB backend
VITE_USE_MOCK=true
